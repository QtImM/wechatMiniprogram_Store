# Copy to .env to override local Docker Compose defaults. Never commit real credentials.
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3307
REDIS_PORT=6380
BACKEND_PORT=8085

# 本地默认使用模拟微信身份。真实联调时设置为 false，并在本机 .env 中填写小程序 AppID 和 AppSecret。
WX_MA_MOCK_ENABLED=true
WX_MA_APPID=
WX_MA_SECRET=

# 生产环境请复制 .env.prod.example 为 .env.prod，并填入客户真实资料。
# .env.prod 已加入 .gitignore，禁止提交。
